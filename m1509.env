# 두산 M1509. systemd EnvironmentFile 로만 넣고, 코드 옆 .env(robot-1)와 섞이지 않게
# 장치마다 달라지는 값은 여기에 모두 적는다. 비어 있는 키는 .env 값으로 채워진다.

MEMORY_MAP_FILE=profiles/m1509/m1509_memory_map.json

# 수집 루프
MODBUS_MODE=tcp
POLL_INTERVAL_SEC=0.1
RECONNECT_INTERVAL_SEC=3.0
LOG_LEVEL=INFO

# engineering.csv SourceInterface Endpoint
MODBUS_TCP_HOST=192.168.1.100
MODBUS_TCP_PORT=502
MODBUS_TCP_DEVICE_ID=1
MODBUS_TCP_TIMEOUT=3.0
MODBUS_TCP_RETRIES=3

# 토픽: collector.robot.m1509.*. DEVICE_KEY 에 '.' 금지
DEVICE_KEY=m1509
GATEWAY_ADDRESS=gateway
# 미들웨어 SUB. 이 수집기는 connect 한다.
ZMQ_PUB_ENDPOINT=tcp://127.0.0.1:5556
ZMQ_SUB_ENDPOINT=tcp://127.0.0.1:5555
ZMQ_PUB_BIND=false
ZMQ_SUB_BIND=false
ZMQ_RECV_TIMEOUT_MS=100
ZMQ_LINGER_MS=0
